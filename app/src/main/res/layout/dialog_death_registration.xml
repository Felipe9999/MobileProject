<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_alert_triangle"
            app:tint="@color/rose_600" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="Registrar Fallecimiento"
            android:textColor="@color/rose_900"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDeathDialogPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Esta acción marcará el registro como 'Fallecido' en el censo municipal, desactivando las alertas de vacunación."
        android:textColor="@color/slate_600"
        android:textSize="12sp" />

    <!-- Fecha de Fallecimiento -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-bold"
        android:text="Fecha de Fallecimiento *"
        android:textColor="@color/slate_800"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etDeathDate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_box"
        android:hint="2026-02-28"
        android:inputType="date"
        android:paddingHorizontal="12dp"
        android:textColor="@color/slate_900"
        android:textSize="12sp" />

    <!-- Motivo de Fallecimiento -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-bold"
        android:text="Causa o Motivo Principal *"
        android:textColor="@color/slate_800"
        android:textSize="11sp" />

    <Spinner
        android:id="@+id/spinnerDeathReason"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_box"
        android:paddingHorizontal="8dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelDeath"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="@color/slate_700" />

        <Button
            android:id="@+id/btnConfirmDeath"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/rose_600"
            android:text="Confirmar Baja"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
