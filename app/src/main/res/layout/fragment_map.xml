<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_100"
    android:orientation="vertical">

    <!-- Top Emerald Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emerald_800"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_compass"
            app:tint="@color/emerald_200" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/header_map_sub"
                android:textColor="@color/emerald_200"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/header_map_title"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerMapVereda"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_emerald"
            android:backgroundTint="@color/emerald_900"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- Subheader with canine / feline count & GPS reference -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvMapDogsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="🐶 Caninos: 10"
            android:textColor="@color/blue_700"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvMapCatsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="🐱 Felinos: 5"
            android:textColor="@color/indigo_700"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_emerald"
            android:fontFamily="monospace"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="WGS84 • Zipaquirá - Tabio"
            android:textColor="@color/emerald_800"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Map Canvas Container with background map image & interactive pin overlays -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E8F5E9">

        <ImageView
            android:id="@+id/ivMapBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/vereda_map_bg" />

        <!-- Overlay filter -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0A064E3B" />

        <!-- Road Labels Overlay -->
        <TextView
            android:id="@+id/tvRoadLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="80dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:rotation="-15"
            android:text="🛣️ Vía Zipaquirá - Tabio"
            android:textColor="@color/slate_700"
            android:textSize="10sp" />

        <!-- Floating animal pins container -->
        <FrameLayout
            android:id="@+id/layoutAnimalPins"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Map Controls Floating Panel (Zoom In, Zoom Out, Reset) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card_white"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Acercar mapa"
                android:src="@drawable/ic_zoom_in"
                app:tint="@color/slate_700" />

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/slate_200" />

            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Alejar mapa"
                android:src="@drawable/ic_zoom_out"
                app:tint="@color/slate_700" />
        </LinearLayout>
    </FrameLayout>

    <!-- Selected Pin Bottom Drawer Preview -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapSelectedRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/slate_200"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/avatarMapFrame"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_blue">

                    <TextView
                        android:id="@+id/tvMapSelectedEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🐶"
                        android:textSize="20sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMapSelectedName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/slate_900"
                            android:textSize="14sp"
                            tools:text="Lucas" />

                        <TextView
                            android:id="@+id/tvMapSelectedId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_slate"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1dp"
                            android:textColor="@color/slate_600"
                            android:textSize="9sp"
                            tools:text="CEN-001" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMapSelectedBreed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/slate_500"
                        android:textSize="11sp"
                        tools:text="Criollo / Mestizo • Vereda San Jorge" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnMapOpenDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/emerald_700"
                    android:fontFamily="sans-serif-bold"
                    android:text="Ver Ficha"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMapSelectedGps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    tools:text="GPS: 4.9842, -73.9562" />

                <TextView
                    android:id="@+id/tvMapSelectedOwner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/slate_600"
                    android:textSize="10sp"
                    tools:text="Resp: Carlos Rodríguez" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
