<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/navigationBarColor"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Radicar Denuncia por Presunto Maltrato"
        android:textColor="@color/slate_900"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Atención prioritaria de la Secretaría de Desarrollo Rural y Ambiente"
        android:textColor="@color/slate_500"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="380dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Modalidad de Reserva de Identidad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Modalidad de Privacidad (TRD FR-4.1) *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgPrivacyMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbReservedIdentity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Identidad Reservada"
                    android:textColor="@color/slate_800"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbAnonymous"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="100% Anónimo"
                    android:textColor="@color/slate_800"
                    android:textSize="11sp" />
            </RadioGroup>

            <!-- Datos de Contacto (visible only if Reserved Identity) -->
            <EditText
                android:id="@+id/etComplaintContact"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:hint="Tu nombre y teléfono (Uso confidencial de inspectores)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/slate_900"
                android:textSize="12sp" />

            <!-- Vereda del Hecho -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Vereda / Territorio *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerComplaintVereda"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:paddingHorizontal="8dp" />

            <!-- Dirección / Referencia de Predio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Dirección o Referencia del Predio *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etComplaintAddress"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:hint="Ej. Casa verde frente a la escuela rural"
                android:inputType="textCapSentences"
                android:paddingHorizontal="12dp"
                android:textColor="@color/slate_900"
                android:textSize="13sp" />

            <!-- Gravedad Preliminar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Severidad / Tipología de Riesgo *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerComplaintSeverity"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:paddingHorizontal="8dp" />

            <!-- Hechos Narrados -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Descripción de los Hechos *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etComplaintDescription"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:gravity="top|start"
                android:hint="Describa el estado del animal, falta de agua/comida, ataduras o agresiones..."
                android:inputType="textMultiLine|textCapSentences"
                android:padding="10dp"
                android:textColor="@color/slate_900"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelComplaint"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancelar"
            android:textColor="@color/slate_600" />

        <Button
            android:id="@+id/btnSaveComplaint"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/rose_600"
            android:text="Radicar Denuncia"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>
</LinearLayout>
