<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvLocationSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="Ubicación en Mapa (OpenStreetMap) *"
        android:textColor="@color/slate_800"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvLocationSectionSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Usa tu GPS o mueve el pin en el mapa. La vereda y dirección se completarán automáticamente."
        android:textColor="@color/slate_500"
        android:textSize="11sp" />

    <!-- Action Bar with GPS and Fullscreen Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLocationGps"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/blue_50"
            android:text="📍 GPS Actual"
            android:textColor="@color/blue_700"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLocationFullscreen"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="⛶ Pantalla Completa"
            android:textColor="@color/slate_700"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Interactive OpenStreetMap Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLocationMap"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/slate_300"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/mapLocationWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_stat_dark"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tvLocationCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Lat: 4.9842, Lng: -73.9562"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Territory Detected Live Chip -->
    <LinearLayout
        android:id="@+id/layoutLocationDetectedBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_emerald"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/emerald_700" />

        <TextView
            android:id="@+id/tvLocationDetectedVereda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-bold"
            android:text="Territorio detectado: Vereda San Jorge"
            android:textColor="@color/emerald_900"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Vereda Oficial -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-bold"
        android:text="Vereda Oficial (Autocompletada por mapa) *"
        android:textColor="@color/slate_800"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerLocationVereda"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_box"
        android:paddingHorizontal="8dp" />

    <!-- Dirección / Predio -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-bold"
        android:text="Dirección / Predio o Sector de Referencia (Autocompletada) *"
        android:textColor="@color/slate_800"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etLocationAddress"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_box"
        android:hint="Ej. Vereda San Jorge, Sector Finca El Porvenir"
        android:inputType="textCapSentences"
        android:paddingHorizontal="12dp"
        android:textColor="@color/slate_900"
        android:textSize="13sp" />

</LinearLayout>
