<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_900"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header & Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnLoginBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar"
                android:src="@drawable/ic_close"
                app:tint="?android:attr/navigationBarColor" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvServerStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_emerald"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Servidor Alcaldía Online"
                android:textColor="?attr/colorSecondaryVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Brand Icon & App Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_pill_blue"
                android:backgroundTint="?attr/colorPrimary">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_check"
                    app:tint="?android:attr/navigationBarColor" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:text="Censo Animal Rural"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Alcaldía Municipal • Sistema Oficial de Identificación"
                android:textColor="@color/slate_400"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Login Credentials Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/slate_800"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/slate_700"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Email Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Correo Electrónico Institucional"
                    android:textColor="@color/slate_300"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etLoginEmail"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_search_box"
                    android:backgroundTint="@color/slate_900"
                    android:hint="nombre@alcaldia.gov.co"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="12dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textColorHint="@color/slate_500"
                    android:textSize="12sp" />

                <!-- Password Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Contraseña"
                    android:textColor="@color/slate_300"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etLoginPassword"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_search_box"
                    android:backgroundTint="@color/slate_900"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textColorHint="@color/slate_500"
                    android:textSize="12sp" />

                <!-- Remember offline token & Forgot pass -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbRememberOffline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Guardar sesión offline"
                        android:textColor="@color/slate_400"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="¿Olvidó clave?"
                        android:textColor="@color/blue_400"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Login Button -->
                <Button
                    android:id="@+id/btnSubmitLogin"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:fontFamily="sans-serif-bold"
                    android:text="Ingresar al Sistema"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="13sp" />

                <!-- Continuar sin cuenta Button -->
                <Button
                    android:id="@+id/btnContinueWithoutAccount"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="Continuar sin cuenta"
                    android:textColor="@color/slate_200"
                    android:textSize="12sp"
                    app:strokeColor="@color/slate_600" />

                <!-- Register Account Link -->
                <TextView
                    android:id="@+id/tvGoToRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="¿No tiene cuenta? Regístrese aquí"
                    android:textColor="@color/emerald_400"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Preset Demo Accounts Switcher -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:text="Cuentas Prediseñadas (Demostración Rápida)"
            android:textColor="@color/slate_400"
            android:textSize="11sp" />

        <!-- Vet Account Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSelectPresetVet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/slate_800"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/slate_700"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👨‍⚕️"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Veterinario Aliado (Campo Completo)"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="veterinario.campo@alcaldia.gov.co"
                        android:textColor="@color/slate_400"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPresetVetBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_blue"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Usar"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="9sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Admin Municipal Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSelectPresetOfficial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/slate_800"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/slate_700"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏛️"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Administrador Municipal (Control Total)"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="admin.ambiental@alcaldia.gov.co"
                        android:textColor="@color/slate_400"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPresetOfficialBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_emerald"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Usar"
                    android:textColor="@color/emerald_800"
                    android:textSize="9sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Citizen Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSelectPresetCitizen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/slate_800"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/slate_700"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Ciudadano / Propietario (Habeas Data)"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ciudadano.rural@gmail.com"
                        android:textColor="@color/slate_400"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPresetCitizenBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_amber"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Usar"
                    android:textColor="@color/amber_800"
                    android:textSize="9sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
