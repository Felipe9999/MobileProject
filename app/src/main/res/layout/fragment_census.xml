<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Hidden legacy badge view to prevent NPE in existing bindings -->
        <TextView
            android:id="@+id/tvTotalBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    <!-- Quick Access to Modules (TRD Pérdidas & Maltrato) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <Button
            android:id="@+id/btnOpenLostFound"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="@color/blue_50"
            android:paddingHorizontal="4dp"
            android:text="🐾 Pérdidas / Hallazgos"
            android:textColor="?attr/colorPrimaryVariant"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnOpenMistreatment"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/rose_50"
            android:paddingHorizontal="4dp"
            android:text="🛡️ Casos de Maltrato"
            android:textColor="@color/rose_700"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Search Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/slate_400" />

            <EditText
                android:id="@+id/etSearchCensus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_placeholder"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/slate_900"
                android:textColorHint="@color/slate_400"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@null"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/slate_400" />
        </LinearLayout>

        <!-- Quick Filter Buttons Horizontal Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutFilterChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Todos (15)"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterDogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_slate"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Perros (10)"
                    android:textColor="@color/slate_700"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterCats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_slate"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Gatos (5)"
                    android:textColor="@color/slate_700"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterSterilized"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_slate"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Esterilizados (7)"
                    android:textColor="@color/slate_700"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFilterAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_slate"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Alertas (1)"
                    android:textColor="@color/slate_700"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Vereda Selector Spinner Bar -->
        <LinearLayout
            android:id="@+id/layoutVeredaFilterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Vereda:"
                android:textColor="@color/slate_500"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinnerVeredaFilter"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_slate"
                android:paddingHorizontal="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Census Records RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCensusRecords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="80dp"
        tools:listitem="@layout/item_animal_record" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="No se encontraron registros"
            android:textColor="@color/slate_700"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Prueba con otro término de búsqueda o filtro de vereda."
            android:textAlignment="center"
            android:textColor="@color/slate_400"
            android:textSize="12sp" />
    </LinearLayout>

    </LinearLayout>

    <!-- Floating Action Button for Registering Companion Animal -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabRegisterAnimal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="?attr/colorSecondary"
        android:fontFamily="sans-serif-bold"
        android:text="Registrar animal"
        android:textColor="?attr/colorOnPrimary"
        app:icon="@drawable/ic_plus"
        app:iconTint="?attr/colorOnPrimary" />

</FrameLayout>
