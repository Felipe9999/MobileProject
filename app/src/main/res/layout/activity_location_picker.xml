<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Navigation Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorOnSecondaryContainer"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp">

            <ImageButton
                android:id="@+id/btnBackMapPicker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regresar"
                android:src="@drawable/ic_arrow_left"
                app:tint="?android:attr/navigationBarColor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Ubicación en OpenStreetMap"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arrastra el pin o toca el mapa para ubicar el predio"
                    android:textColor="@color/blue_200"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Reset to GPS button in header -->
            <Button
                android:id="@+id/btnHeaderGps"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="?attr/colorPrimaryVariant"
                android:paddingHorizontal="10dp"
                android:text="GPS Actual"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quick Vereda Jump Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/navigationBarColor"
            android:elevation="2dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutVeredaChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!-- Dynamically populated chips -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Main OpenStreetMap Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webViewOpenStreetMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Floating GPS FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCurrentLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Centrar en mi ubicación GPS"
                android:src="@drawable/ic_compass"
                app:backgroundTint="?android:attr/navigationBarColor"
                app:elevation="6dp"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <!-- Bottom Selection Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/navigationBarColor"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_map_pin"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvPickerVeredaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_blue"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Vereda San Jorge"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPickerCoords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="4.9842, -73.9562"
                    android:textColor="@color/slate_500"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Dirección / Predio detectado automáticamente:"
                android:textColor="@color/slate_600"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPickerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_pill_slate"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="Vereda San Jorge, Sector Finca El Porvenir"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConfirmLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="?attr/colorPrimary"
                android:fontFamily="sans-serif-bold"
                android:text="✓ Confirmar y Usar Esta Ubicación"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
