<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <!-- Top Blue Official Header -->
    <LinearLayout
        android:id="@+id/headerVirtualCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimaryVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_left"
            app:tint="?attr/colorOnPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.06"
                android:text="IDENTIFICACIÓN Y REGISTRO OFICIAL"
                android:textColor="?attr/colorPrimaryContainer"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Carné Virtual Animal"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_blue_stroke"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="OFICIAL"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_blue"
            android:backgroundTint="?attr/colorOnPrimaryContainer">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_check"
                app:tint="?attr/colorSecondary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Main Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Official Municipal Identification Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Card Header Banner (Emerald/Teal Theme Secondary) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_carne_card_header"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <!-- ALC Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_carne_badge_alc"
                            android:fontFamily="sans-serif-black"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:text="ALC"
                            android:textColor="?attr/colorOnSecondary"
                            android:textSize="10sp" />

                        <!-- Header Text -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="ALCALDÍA MUNICIPAL • SECRETARÍA DE HÁBITAT"
                                android:textColor="?attr/colorSecondaryContainer"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Censo Rural y Control Poblacional"
                                android:textColor="?attr/colorOnSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Year Badge -->
                        <TextView
                            android:id="@+id/tvCarneYearBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_carne_badge_cen"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="CEN-2026"
                            android:textColor="?attr/colorSecondaryContainer"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Animal Profile Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="12dp">

                        <!-- Avatar with Theme Ring -->
                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_carne_avatar_ring">

                            <TextView
                                android:id="@+id/tvCarneEmoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textSize="28sp"
                                tools:text="🐶" />
                        </FrameLayout>

                        <!-- Main Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Name + ID + Status -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                android:id="@+id/tvCarneName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                tools:text="Lucas" />

                            <TextView
                                android:id="@+id/tvCarneRecordId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_pill_slate"
                                android:backgroundTint="?attr/colorSurfaceVariant"
                                android:fontFamily="monospace"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="10sp"
                                tools:text="CEN-2026-001" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvCarneStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_emerald"
                                android:fontFamily="sans-serif-bold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Activo"
                                android:textColor="?attr/colorSecondaryVariant"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Species, Breed & Age -->
                        <TextView
                            android:id="@+id/tvCarneSpeciesBreedAge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            tools:text="Canino Criollo / Mestizo • Macho • 24 Meses" />

                        <!-- Location -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_map_pin"
                                app:tint="?attr/colorSecondary" />

                            <TextView
                                android:id="@+id/tvCarneLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp"
                                tools:text="Vereda San Jorge Centro" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Center QR Code Graphic Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="170dp"
                        android:layout_height="170dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:contentPadding="8dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/ivCarneQr"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Código QR Oficial"
                            android:src="@drawable/ic_carne_qr_code" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvCarneUuidVerification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="9sp"
                        tools:text="UUID: 981050102938401 • VERIF. INMEDIATA" />
                </LinearLayout>

                <!-- Sanitary & Guardian Details Table -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_carne_info_box"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Row 1: Rabies Vaccine -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●"
                            android:textColor="?attr/colorSecondary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Vacuna Antirrábica:"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCarneRabiesBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_emerald_stroke"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Vigente (12/03/2026)"
                            android:textColor="?attr/colorSecondaryVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Row 2: Sterilized -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Esterilizado:"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCarneSterilizedBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_blue_light_stroke"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Sí (Certificado B84-J)"
                            android:textColor="?attr/colorPrimaryVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Row 3: Institutional Tattoo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Tatuaje Institucional:"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCarneTattooValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Presente (Oreja Derecha)"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Row 4: Responsible Guardian -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Tenedor Resp.:"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCarneOwnerValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            tools:text="Carlos Rodríguez (C.C. Rural Activo)" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Cryptographic Signature Footer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="?attr/colorSecondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Firma Criptográfica Válida"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvCarneExp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="EXP: 12/2026"
                        android:textColor="?attr/colorOutline"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row (Compartir Carné & Descargar Offline) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Left Button: Compartir Carné -->
                <LinearLayout
                    android:id="@+id/btnShareCarne"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_white_outlined"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_share"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Compartir Carné"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Right Button: Descargar Offline -->
                <LinearLayout
                    android:id="@+id/btnDownloadCarne"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_blue_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_download"
                        app:tint="?attr/colorOnPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Descargar Offline"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
