<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_100"
    android:orientation="vertical">

    <!-- Standardized Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rose_800"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBackReportLost"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Red Comunitaria Zipaquirá"
                android:textColor="@color/rose_200"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Reportar Animal Perdido"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Standardized Account Dropdown Trigger -->
        <LinearLayout
            android:id="@+id/btnAccountReportLost"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_blue"
            android:backgroundTint="@color/rose_900"
            android:clickable="true"
            android:contentDescription="Menú de Cuenta"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_user"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvAccountReportLostLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="Usuario"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Official Alert Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_rose"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Alerta de Búsqueda Activa"
                        android:textColor="@color/rose_900"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tu reporte se difundirá de inmediato en el mapa comunal de Zipaquirá y ante los veterinarios e inspectores del albergue municipal."
                        android:textColor="@color/rose_900"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 1: Datos del Animal -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="1. Identificación del Animal de Compañía"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Nombre del Animal -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Nombre del Animal de Compañía *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etLostAnimalName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. Toby, Canela, Luna..."
                        android:inputType="textCapWords"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Especie y Sexo en fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Especie *"
                                android:textColor="@color/slate_800"
                                android:textSize="11sp" />

                            <Spinner
                                android:id="@+id/spinnerLostSpecies"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_search_box"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Sexo *"
                                android:textColor="@color/slate_800"
                                android:textSize="11sp" />

                            <Spinner
                                android:id="@+id/spinnerLostSex"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_search_box"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Raza / Mestizaje -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Raza o Mestizaje *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etLostBreed"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. Golden Retriever / Mestizo criollo"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Color Dominante -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Color Dominante *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spinnerLostColor"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:paddingHorizontal="8dp" />

                    <!-- Microchip (opcional) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Código Microchip (Opcional - Cruce automático)"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etLostMicrochip"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. 981098102938411 (si lo conoce)"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Señas Particulares -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Señas Particulares y Accesorios"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etLostDistinctiveMarks"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. Collar azul reflectivo con placa, mancha en el ojo..."
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Fecha de Pérdida -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Fecha de la Pérdida *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etLostDate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="YYYY-MM-DD"
                        android:inputType="date"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Reusable OpenStreetMap Location Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="2. Lugar de Pérdida / Última Vez Visto"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <include
                        android:id="@+id/locationPickerSectionLost"
                        layout="@layout/layout_form_location_picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Datos de Contacto del Guardián -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="3. Datos de Contacto del Guardián"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Nombre de Contacto -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Nombre del Guardián / Contacto *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etLostContactName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. Elena Suárez"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Teléfono / WhatsApp -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Teléfono Celular / WhatsApp de Contacto *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etLostContactPhone"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. 3129847162"
                        android:inputType="phone"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Circunstancias de la Pérdida -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="4. Circunstancias y Detalles de Búsqueda"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etLostDescription"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_box"
                        android:gravity="top|start"
                        android:hint="Describe cómo se extravió, temperamento con personas o animales, si requiere medicamentos urgentes..."
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <Button
                android:id="@+id/btnSubmitReportLost"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/rose_700"
                android:fontFamily="sans-serif-bold"
                android:text="🚨 Publicar Alerta de Animal Perdido"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnCancelReportLost"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="Cancelar y Regresar"
                android:textColor="@color/slate_600"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
