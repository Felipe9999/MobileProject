<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_100"
    android:orientation="vertical">

    <!-- Standardized Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emerald_800"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBackReportFound"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_left"
            app:tint="?android:attr/navigationBarColor" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Albergue &amp; Red Comunitaria"
                android:textColor="@color/emerald_200"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Reportar Animal Hallado"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Standardized Account Dropdown Trigger -->
        <LinearLayout
            android:id="@+id/btnAccountReportFound"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_blue"
            android:backgroundTint="@color/emerald_900"
            android:clickable="true"
            android:contentDescription="Menú de Cuenta"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_user"
                app:tint="?android:attr/navigationBarColor" />

            <TextView
                android:id="@+id/tvAccountReportFoundLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="Usuario"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Official Alert Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_emerald"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Protocolo de Hallazgo y Custodia Municipal"
                        android:textColor="@color/emerald_900"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="El reporte se cruzará con las alertas de pérdida. Cumple la regla de 20 días de custodia oficial (TRD FR-2.5) para declaratoria de abandono y adopción."
                        android:textColor="@color/emerald_900"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 1: Estado de Custodia -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/navigationBarColor"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="1. Estado de Custodia del Animal Hallado"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Condición de Custodia Actual *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spinnerFoundCustodyState"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:paddingHorizontal="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Días transcurridos en custodia temporal / albergue"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFoundCustodyDays"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="0"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Características del Animal Encontrado -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/navigationBarColor"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="2. Características del Animal"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Nombre o Referencia Tentativa (Opcional)"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFoundTentativeName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. Sin nombre / Canino Negro"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Especie y Sexo en fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Especie *"
                                android:textColor="@color/slate_800"
                                android:textSize="11sp" />

                            <Spinner
                                android:id="@+id/spinnerFoundSpecies"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_search_box"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Sexo Estimado *"
                                android:textColor="@color/slate_800"
                                android:textSize="11sp" />

                            <Spinner
                                android:id="@+id/spinnerFoundSex"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_search_box"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Raza aparente -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Raza o Fenotipo Aparente *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFoundBreed"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. Mestizo criollo, Tipo Labrador..."
                        android:inputType="textCapWords"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Color -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Color Predominante *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spinnerFoundColor"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:paddingHorizontal="8dp" />

                    <!-- Microchip -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Código Microchip (Si fue leído con lector oficial)"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFoundMicrochip"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. 981098102938411"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Accesorios / Señas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Accesorios, Collar o Señas Especiales"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFoundAccessories"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. Collar rojo desgastado, cicatriz en lomo..."
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Fecha del Hallazgo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Fecha del Hallazgo *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFoundDate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="YYYY-MM-DD"
                        android:inputType="date"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Reusable OpenStreetMap Location Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/navigationBarColor"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="3. Lugar Exacto del Hallazgo o Custodia"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <include
                        android:id="@+id/locationPickerSectionFound"
                        layout="@layout/layout_form_location_picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Contacto de Quien Reporta -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/navigationBarColor"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="4. Contacto del Rescatista o Entidad Custodia"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Nombre de Contacto -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Nombre del Rescatista / Funcionario *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFoundContactName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. Policía Ambiental / Albergue Zipaquirá / Ciudadano"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Teléfono -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Teléfono Celular de Contacto *"
                        android:textColor="@color/slate_800"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFoundContactPhone"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_search_box"
                        android:hint="Ej. 3209876543"
                        android:inputType="phone"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Estado Físico & Circunstancias -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/navigationBarColor"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="5. Estado de Salud y Circunstancias del Hallazgo"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etFoundDescription"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_box"
                        android:gravity="top|start"
                        android:hint="Condición corporal, comportamiento, si presenta heridas, desnutrición o requiere evaluación veterinaria..."
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <Button
                android:id="@+id/btnSubmitReportFound"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="?attr/colorSecondaryVariant"
                android:fontFamily="sans-serif-bold"
                android:text="🐾 Publicar Alerta de Animal Hallado"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnCancelReportFound"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="Cancelar y Regresar"
                android:textColor="@color/slate_600"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
