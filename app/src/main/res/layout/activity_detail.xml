<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:orientation="vertical">

    <!-- Top Blue Header with Back button & QR Code button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_700"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnDetailBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Hoja de Vida Sanitaria"
                android:textColor="@color/blue_100"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDetailHeaderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:text="Ficha: Lucas" />
        </LinearLayout>

        <!-- QR Code Modal Trigger -->
        <ImageButton
            android:id="@+id/btnDetailShowQr"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_slate"
            android:backgroundTint="@color/blue_800"
            android:contentDescription="Ver QR Oficial"
            android:src="@drawable/ic_qr_code"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Habeas Data / Privacy Mode Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/ivPrivacyIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/blue_600" />

        <TextView
            android:id="@+id/tvPrivacyModeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Modo Oficial • Datos de contacto visibles"
            android:textColor="@color/blue_800"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnTogglePrivacy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Cambiar a Ciudadano"
            android:textColor="@color/blue_600"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Scrollable Detail Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Animal Identity Top Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/avatarDetailFrame"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_pill_blue">

                            <TextView
                                android:id="@+id/tvDetailEmoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🐶"
                                android:textSize="26sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvDetailName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:textColor="@color/slate_900"
                                    android:textSize="18sp"
                                    tools:text="Lucas" />

                                <TextView
                                    android:id="@+id/tvDetailStateBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_pill_emerald"
                                    android:fontFamily="sans-serif-bold"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"
                                    android:text="Activo"
                                    android:textColor="@color/emerald_700"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvDetailBreedAndSex"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/slate_600"
                                android:textSize="12sp"
                                tools:text="Canino (Perro) • Macho • 36 meses" />

                            <TextView
                                android:id="@+id/tvDetailColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/slate_500"
                                android:textSize="11sp"
                                tools:text="Color: Café / Chocolate" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Microchip Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_slate"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_tag"
                            app:tint="@color/slate_600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Microchip RFID:"
                            android:textColor="@color/slate_600"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvDetailMicrochip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:textColor="@color/slate_900"
                            android:textSize="12sp"
                            tools:text="981098102938401" />
                    </LinearLayout>

                    <!-- Behavioral & Custody Badges Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDetailGuardianTypeChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_blue"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Propietario / Tenedor"
                            android:textColor="@color/blue_800"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvDetailTattooChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_emerald"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Tatuaje Auricular"
                            android:textColor="@color/emerald_800"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailBehaviorCondition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/slate_600"
                        android:textSize="11sp"
                        tools:text="Condición: Sociable con personas y otros animales." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sanitary & Reproductive Health Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Esquema Sanitario y Control Reproductivo"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <!-- Sterilization status row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/blue_600" />

                        <TextView
                            android:id="@+id/tvDetailSterilizationStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="Esterilizado: Sí (2024-03-15)"
                            android:textColor="@color/blue_800"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnToggleSterilization"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Modificar"
                            android:textColor="@color/blue_600"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Sterilization tattoo row -->
                    <TextView
                        android:id="@+id/tvDetailTattooDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:textColor="@color/emerald_700"
                        android:textSize="11sp"
                        tools:text="✔ Tatuaje de esterilización verificado en campo" />

                    <!-- Rabies vaccine row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_syringe"
                            app:tint="@color/emerald_600" />

                        <TextView
                            android:id="@+id/tvDetailRabiesStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="Vacuna Antirrábica: 2025-11-20"
                            android:textColor="@color/emerald_800"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnRenewVaccine"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Renovar"
                            android:textColor="@color/emerald_700"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Clinical Records & Veterinary Interventions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="Historia Clínica y Atenciones"
                            android:textColor="@color/slate_900"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnAddClinicalRecord"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:backgroundTint="@color/blue_50"
                            android:text="+ Registrar Atención"
                            android:textColor="@color/blue_700"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Dynamic Clinical Records List Container -->
                    <LinearLayout
                        android:id="@+id/layoutClinicalRecordsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Responsible Owner & Habeas Data Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Datos del Propietario / Responsable"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailOwnerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        tools:text="Nombre: Carlos Rodríguez" />

                    <TextView
                        android:id="@+id/tvDetailOwnerDoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        tools:text="Documento: CC 19283746" />

                    <TextView
                        android:id="@+id/tvDetailOwnerPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        tools:text="Teléfono: 3104829102" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location & Vereda Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Georreferenciación Rural"
                        android:textColor="@color/slate_900"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailVereda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        tools:text="Vereda: Vereda San Jorge" />

                    <TextView
                        android:id="@+id/tvDetailFarmAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        tools:text="Predio: Finca El Porvenir Lote 4" />

                    <TextView
                        android:id="@+id/tvDetailGpsCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/slate_500"
                        android:textSize="11sp"
                        tools:text="GPS: 4.9842, -73.9562" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Deceased Card / Action Button -->
            <Button
                android:id="@+id/btnRegisterDecease"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/rose_600"
                android:fontFamily="sans-serif-bold"
                android:text="Registrar Fallecimiento / Baja Sanitaria"
                android:textColor="@color/white" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
