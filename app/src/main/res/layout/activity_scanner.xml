<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_900"
    android:orientation="vertical">

    <!-- Top Dark Bar with Back button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_900"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnScannerBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_left"
            app:tint="?android:attr/navigationBarColor" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Lectura de Identificación"
                android:textColor="@color/blue_300"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Escáner QR &amp; Lector RFID"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_radio"
            app:tint="@color/emerald_400" />

        <!-- Standardized Account Button with Dropdown Trigger -->
        <LinearLayout
            android:id="@+id/btnScannerAccount"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_blue"
            android:backgroundTint="@color/slate_800"
            android:clickable="true"
            android:contentDescription="Menú de Cuenta"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_user"
                app:tint="?android:attr/navigationBarColor" />

            <TextView
                android:id="@+id/tvScannerAccountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="Veterinario"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/slate_400" />
        </LinearLayout>
    </LinearLayout>

    <!-- Habeas data privacy bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_800"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/emerald_400" />

        <TextView
            android:id="@+id/tvScannerPrivacyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Modo Oficial • Desbloquea titular"
            android:textColor="@color/slate_300"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnToggleScannerPrivacy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Cambiar a Ciudadano"
            android:textColor="@color/blue_300"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Camera Viewfinder & Laser Animation Simulation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050B14">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Square Reticle / Viewfinder -->
            <FrameLayout
                android:id="@+id/viewfinderReticle"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_scanner_reticle">

                <!-- Animated Laser scan line -->
                <View
                    android:id="@+id/laserLine"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="top"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/blue_500" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="Apunta al código QR o acerca el lector RFID"
                    android:textAlignment="center"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvScanningStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Sensor de cámara activo • Listo para capturar"
                android:textColor="@color/slate_300"
                android:textSize="11sp" />

            <!-- Test Trigger Simulation Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSimulateQr"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Escanear QR de Lucas"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSimulateRfid"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:text="Leer Chip de Michi"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Manual Input & Scanned Animal Preview Drawer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_800"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Búsqueda Manual de Microchip o ID de Censo"
            android:textColor="@color/slate_300"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etManualSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_search_box"
                android:backgroundTint="@color/slate_900"
                android:fontFamily="monospace"
                android:hint="Ej. 981098102938401 o CEN-001"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorOnPrimary"
                android:textColorHint="@color/slate_500"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSearchManual"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:backgroundTint="?attr/colorPrimary"
                android:text="Buscar"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Scanned Result Preview Card (Visible when found) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScannedResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/slate_900"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/emerald_500"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvScannedEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐶"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvScannedName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="14sp"
                            tools:text="Lucas" />

                        <TextView
                            android:id="@+id/tvScannedSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/slate_400"
                            android:textSize="11sp"
                            tools:text="Perro • Criollo • Vereda San Jorge" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnOpenScannedDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="?attr/colorSecondary"
                        android:text="Abrir Ficha"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
