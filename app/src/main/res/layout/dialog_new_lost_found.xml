<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Publicar Reporte de Pérdida / Hallazgo"
        android:textColor="@color/slate_900"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Notificación oficial a la red comunitaria y albergue municipal"
        android:textColor="@color/slate_500"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="380dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tipo de Reporte: Perdido vs Hallado -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Tipo de Reporte *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerAlertType"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:paddingHorizontal="8dp" />

            <!-- Especie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Especie *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerAlertSpecies"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:paddingHorizontal="8dp" />

            <!-- Nombre / Raza / Color -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Nombre (si se conoce) / Raza *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etAlertNameBreed"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:hint="Ej. Toby / Labrador Mestizo Dorado"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="@color/slate_900"
                android:textSize="13sp" />

            <!-- Vereda Oficial -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Vereda del Evento *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerAlertVereda"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:paddingHorizontal="8dp" />

            <!-- Contacto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Nombre de Contacto y Teléfono *"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etAlertContact"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:hint="Ej. Elena Suárez - 3129847162"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/slate_900"
                android:textSize="13sp" />

            <!-- Descripción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="Descripción y Señas Particulares"
                android:textColor="@color/slate_800"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etAlertDescription"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_box"
                android:gravity="top|start"
                android:hint="Collar reflectivo, cicatriz, circunstancias de pérdida..."
                android:inputType="textMultiLine|textCapSentences"
                android:padding="10dp"
                android:textColor="@color/slate_900"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelNewAlert"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancelar"
            android:textColor="@color/slate_600" />

        <Button
            android:id="@+id/btnSaveNewAlert"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/blue_700"
            android:text="Publicar Reporte"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
